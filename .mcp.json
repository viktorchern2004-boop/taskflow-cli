{
  "mcpServers": {
    "taskflowVault": {
      "type": "stdio",
      "command": "${TASKFLOW_PYTHON}",
      "args": [
        "-m",
        "mcp_vault.server"
      ],
      "env": {
        "TASKFLOW_VAULT_PATH": "${TASKFLOW_VAULT_PATH}",
        "VAULT_GIT_BRANCH": "pr3-mcp-ingestion"
      },
      "tools": [
        "get_note",
        "search_notes",
        "ingest_note"
      ]
    },
    "githubReadOnly": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_MCP_TOKEN}",
        "X-MCP-Readonly": "true",
        "X-MCP-Toolsets": "repos,pull_requests,issues"
      },
      "tools": [
        "*"
      ]
    }
  }
}
